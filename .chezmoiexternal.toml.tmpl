{{- /*
  Binaries downloaded to ~/.local/bin from GitHub/GitLab releases,
  plus the iTerm2 shell integration scripts.

  Naming schemes used by the upstream release assets:
    $target   Rust target triple, e.g. x86_64-unknown-linux-musl, aarch64-apple-darwin
              (Linux always uses the statically linked musl builds)
    $goArch   x86_64 | arm64             (glow, gping)
    .chezmoi.arch  amd64 | arm64         (fzf, gh, glab, direnv)

  Archives with a versioned top-level directory use stripComponents = 1,
  so no separate version lookup is needed. Asset names use globs (*) for
  the version.
*/ -}}
{{- $os := .chezmoi.os }}
{{- $arch := .chezmoi.arch }}
{{- $rustArch := ternary "aarch64" "x86_64" (eq $arch "arm64") }}
{{- $goArch := ternary "arm64" "x86_64" (eq $arch "arm64") }}
{{- $linux := eq $os "linux" }}
{{- $target := ternary (printf "%s-unknown-linux-musl" $rustArch) (printf "%s-apple-darwin" $rustArch) $linux }}

{{- /* ---------- all platforms ---------- */}}
{{- range list "zsh" "bash" }}

[".iterm2_shell_integration.{{ . }}"]
   type = "file"
   url = "https://iterm2.com/shell_integration/{{ . }}"
   refreshPeriod = "168h"
{{- end }}
{{- $batExtras := gitHubLatestReleaseAssetURL "eth-p/bat-extras" "bat-extras-*.zip" }}
{{- range list "batdiff" "batgrep" "batman" "batpipe" "batwatch" "prettybat" }}

[".local/bin/{{ . }}"]
   type = "archive-file"
   url = {{ $batExtras | quote }}
   path = "bin/{{ . }}"
   executable = true
   refreshPeriod = "168h"
{{- end }}

{{- /* Rust tools whose archive is <name>-<version>-<target>/<bin> */}}
{{- range list
      (list "bat"       "sharkdp/bat"        "bat-*-%s.tar.gz")
      (list "fd"        "sharkdp/fd"         "fd-*-%s.tar.gz")
      (list "rg"        "BurntSushi/ripgrep" "ripgrep-*-%s.tar.gz")
      (list "dust"      "bootandy/dust"      "dust-*-%s.tar.gz")
      (list "hyperfine" "sharkdp/hyperfine"  "hyperfine-*-%s.tar.gz")
      (list "sd"        "chmln/sd"           "sd-*-%s.tar.gz")
      (list "git-cliff" "orhun/git-cliff"    "git-cliff-*-%s.tar.gz")
      (list "uv"        "astral-sh/uv"       "uv-%s.tar.gz")
      (list "uvx"       "astral-sh/uv"       "uv-%s.tar.gz") }}

[".local/bin/{{ index . 0 }}"]
   type = "archive-file"
   url = {{ gitHubLatestReleaseAssetURL (index . 1) (printf (index . 2) $target) | quote }}
   stripComponents = 1
   path = "{{ index . 0 }}"
   executable = true
   refreshPeriod = "168h"
{{- end }}

[".local/bin/zoxide"]
   type = "archive-file"
   url = {{ gitHubLatestReleaseAssetURL "ajeetdsouza/zoxide" (printf "zoxide-*-%s.tar.gz" $target) | quote }}
   path = "zoxide"
   executable = true
   refreshPeriod = "168h"

[".local/bin/btm"]
   type = "archive-file"
   url = {{ gitHubLatestReleaseAssetURL "ClementTsang/bottom" (printf "bottom_%s.tar.gz" $target) | quote }}
   path = "btm"
   executable = true
   refreshPeriod = "168h"

[".local/bin/procs"]
   type = "archive-file"
   url = {{ gitHubLatestReleaseAssetURL "dalance/procs" (printf "procs-*-%s-%s.zip" $rustArch (ternary "linux" "mac" $linux)) | quote }}
   path = "procs"
   executable = true
   refreshPeriod = "168h"

[".local/bin/tldr"]
   type = "file"
   url = {{ gitHubLatestReleaseAssetURL "tealdeer-rs/tealdeer" (ternary (printf "tealdeer-linux-%s-musl" $rustArch) (printf "tealdeer-macos-%s" $rustArch) $linux) | quote }}
   executable = true
   refreshPeriod = "168h"

[".local/bin/gping"]
   type = "archive-file"
   url = {{ gitHubLatestReleaseAssetURL "orf/gping" (ternary (printf "gping-Linux-musl-%s.tar.gz" $goArch) (printf "gping-macOS-%s.tar.gz" $goArch) $linux) | quote }}
   path = "gping"
   executable = true
   refreshPeriod = "168h"

[".local/bin/glow"]
   type = "archive-file"
   url = {{ gitHubLatestReleaseAssetURL "charmbracelet/glow" (printf "glow_*_%s_%s.tar.gz" (ternary "Linux" "Darwin" $linux) $goArch) | quote }}
   stripComponents = 1
   path = "glow"
   executable = true
   refreshPeriod = "168h"

{{- /* ---------- Linux only (on macOS these come from MacPorts) ---------- */}}
{{- if $linux }}

[".local/bin/fzf"]
   type = "archive-file"
   url = {{ gitHubLatestReleaseAssetURL "junegunn/fzf" (printf "fzf-*-linux_%s.tar.gz" $arch) | quote }}
   path = "fzf"
   executable = true
   refreshPeriod = "168h"

[".local/bin/direnv"]
   type = "file"
   url = {{ gitHubLatestReleaseAssetURL "direnv/direnv" (printf "direnv.linux-%s" $arch) | quote }}
   executable = true
   refreshPeriod = "168h"

[".local/bin/starship"]
   type = "archive-file"
   url = {{ gitHubLatestReleaseAssetURL "starship/starship" (printf "starship-%s.tar.gz" $target) | quote }}
   path = "starship"
   executable = true
   refreshPeriod = "168h"

[".local/bin/gh"]
   type = "archive-file"
   url = {{ gitHubLatestReleaseAssetURL "cli/cli" (printf "gh_*_linux_%s.tar.gz" $arch) | quote }}
   stripComponents = 1
   path = "bin/gh"
   executable = true
   refreshPeriod = "168h"

[".local/bin/eza"]
   type = "archive-file"
   url = {{ gitHubLatestReleaseAssetURL "eza-community/eza" (printf "eza_%s-unknown-linux-gnu.tar.gz" $rustArch) | quote }}
   path = "./eza"
   executable = true
   refreshPeriod = "168h"

{{- /* GitLab: resolve the latest version from the permalink redirect */}}
{{- $glabPermalink := "https://gitlab.com/gitlab-org/cli/-/releases/permalink/latest/downloads/glab_%s_linux_%s.tar.gz" }}
{{- $glabVersion := getRedirectedURL (printf $glabPermalink "0.0.0" $arch) | regexFind "[0-9]+\\.[0-9]+\\.[0-9]+" }}

[".local/bin/glab"]
   type = "archive-file"
   url = {{ printf $glabPermalink $glabVersion $arch | quote }}
   path = "bin/glab"
   executable = true
   refreshPeriod = "168h"
{{- end }}
