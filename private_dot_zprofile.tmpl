# ~/.zprofile
# DO NOT EDIT - file is controlled by chezmoi

{{ if eq .chezmoi.os "darwin" }}
# load ssh keys
/usr/bin/ssh-add --apple-load-keychain 2>/dev/null
{{ end -}}

{{ if eq .chezmoi.os "darwin" }}
export PATH="$HOME/.local/bin:/opt/local/bin:/opt/local/sbin:$PATH"
{{ else }}
export PATH="$HOME/.local/bin:$PATH"
{{ end -}}

{{- if eq .chezmoi.os "linux" }}
# Refresh VOMS proxy once per day (needs the ssh-agent for its passphrase)
if [ -S "${SSH_AUTH_SOCK-}" ] && command -v voms-agent >/dev/null 2>&1; then
   voms-agent --quiet
fi
{{- end }}
