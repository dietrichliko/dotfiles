# ~/.zprofile
# DO NOT EDIT - file is controlled by chezmoi

{{ if eq .chezmoi.os "darwin" }}
# load ssh keys
/usr/bin/ssh-add --apple-load-keychain 2>/dev/null
{{ end -}}

{{ if eq .chezmoi.os "darwin" }}
export PATH="$HOME/.local/bin:/opt/local/bin:/opt/local/sbin:$PATH"
{{ else }}
export PATH="$HOME/.local/bin:$PATH"
{{ end -}}

{{- if eq .chezmoi.os "linux" }}
# Refresh VOMS proxy once per day
if command -v voms-agent >/dev/null 2>&1; then
   voms-agent --silent
fi
{{- end }}

# Source ~/.zshrc only for interactive shells
if [[ -o interactive ]]; then
    if [ -f ~/.zshrc ]; then
        source ~/.zshrc
    fi
fi

