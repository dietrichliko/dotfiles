# .bash_profile
# DO NOT EDIT - file is controlled by chezmoi

{{ if eq .chezmoi.os "darwin" }}
/usr/bin/ssh-add --apple-load-keychain 2>/dev/null
{{ end -}}

{{ if eq .chezmoi.os "darwin" }}
export PATH="$HOME/.local/bin:/opt/local/bin:/opt/local/sbin:$PATH"
{{ else }}
export PATH="$HOME/.local/bin:$PATH"
{{ end -}}

{{- if eq .chezmoi.os "linux" }}
# Refresh VOMS proxy once per day
if command -v voms-agent >/dev/null 2>&1; then
   voms-agent --quiet
fi
{{- end }}

# Source ~/.bashrc only for interactive shells
if [[ $- == *i* ]]; then
    if [ -f ~/.bashrc ]; then
        source ~/.bashrc
    fi
fi

