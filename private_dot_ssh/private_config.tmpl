# Config generated by chezmoi. DO NOT EDIT.
# The first value obtained for each option wins, so specific hosts come
# before the shared blocks and `Host *` is last.

Host clip cbe.vbc.ac.at
  Hostname cbe.vbc.ac.at
  User dietrich.liko
  ForwardAgent yes

{{- if eq .chezmoi.os "darwin" }}

# Obtain/renew VBC step-ca SSH certificate when needed (always exits 1)
Match originalhost cbe.next,sshjump.vbc.ac.at exec "~/.local/libexec/cbe-login"
{{- end }}

Host sshjump.vbc.ac.at cbe.next
  User dietrich.liko

Host cbe.next
  HostName cbenext.vbc.ac.at
  ProxyJump sshjump.vbc.ac.at

Host cmsconnect login-el7.uscms.org
  Hostname login-el7.uscms.org
  User liko
  ForwardAgent yes

# lxplus with two accounts: delphi uses the dliko account
Host delphi
  User dliko

Host lxplus lxplus.cern.ch delphi
  Hostname lxplus.cern.ch
  User liko
  ForwardAgent yes
  ServerAliveInterval 100
  PubkeyAuthentication no
  HostbasedAuthentication no
  PasswordAuthentication no
  KbdInteractiveAuthentication yes
{{- if hasPrefix "/afs" .chezmoi.homeDir }}
  ControlPath /run/user/%i/%r@%h:%p
{{- else }}
  ControlPath ~/.ssh/%r@%h:%p
{{- end }}
  ControlMaster auto
  ControlPersist 1h

Host hepgpu2
  Hostname hepgpu2.hephy.oeaw.ac.at
  User dliko
  ForwardAgent yes

{{- if eq .location "desktop" }}

Host galileo-local
  Hostname galileo.lan
  User sshd

Host newton-local
  Hostname newton.lan
  User dietrich

Host newton
  Hostname ssh-newton.1251000.xyz
  ForwardAgent yes
  ProxyCommand cloudflared access ssh --hostname %h
{{- end }}

Host gitlab.cern.ch
  Port 7999

{{- if eq .chezmoi.os "darwin" }}

Host *
  UseKeychain yes
  AddKeysToAgent yes
  XAuthLocation /opt/local/bin/xauth
{{- end }}
