  ForwardAgent yes
{{- if eq .chezmoi.os "darwin" }}
  UseKeychain yes
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_ecdsa
{{ end }}

{{- if eq .chezmoi.os "darwin" }}
