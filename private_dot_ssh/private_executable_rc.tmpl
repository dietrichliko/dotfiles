{{- if hasPrefix "/afs/" .chezmoi.homeDir -}}
#!/bin/sh
# ~/.ssh/rc on AFS hosts (lxplus). sshd runs it for every session before
# the shell; it must not write to stdout.

# Because this file exists, sshd does not run xauth itself: add the X11
# cookie here (recipe from sshd(8)).
if read proto cookie && [ -n "$DISPLAY" ] && [ -n "$cookie" ]; then
    case $DISPLAY in
        localhost:*) echo add "unix:${DISPLAY#localhost:}" "$proto" "$cookie" ;;
        *)           echo add "$DISPLAY" "$proto" "$cookie" ;;
    esac | xauth -q -
fi

# Keep the Kerberos ticket and AFS token of this login alive. The ticket
# cache is per user and node (/run/user/$UID/krb5cc), so one detached
# krenew per user is enough; -t runs aklog after each renewal.
command -v krenew >/dev/null 2>&1 || exit 0
klist -s 2>/dev/null || exit 0
pidfile="/run/user/$(id -u)/krenew.pid"
if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    exit 0
fi
krenew -b -t -K 30 -p "$pidfile" </dev/null >/dev/null 2>&1
exit 0
{{- end -}}
