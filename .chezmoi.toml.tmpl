[data]
{{- if regexMatch "lxplus\\d+\\.cern\\.ch" .chezmoi.fqdnHostname }}
    location = "lxplus"
{{- /* CLIP (*.cbe.vbc.ac.at) and CBE next (*.clip.vbc.ac.at) share the same setup */}}
{{ else if regexMatch "\\.(cbe|clip)\\.vbc\\.ac\\.at$" .chezmoi.fqdnHostname }}
    location = "clip"
{{ else }}
    location = "desktop"
{{ end -}}
[edit]
    command = "vi"
[gitHub]
    # cache GitHub API results (default 1m) to stay under the rate limit
    refreshPeriod = "12h"

