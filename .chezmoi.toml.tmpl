[data]
{{- if regexMatch "lxplus\\d+\\.cern\\.ch" .chezmoi.fqdnHostname }}
    location = "lxplus"
{{ else if regexMatch ".*\\.cbe\\.vbc\\.ac\\.at" .chezmoi.fqdnHostname }}
    location = "clip"
{{ else }}
    location = "desktop"
{{ end -}}
[edit]
    command = "vi"
[gitHub]
    # cache GitHub API results (default 1m) to stay under the rate limit
    refreshPeriod = "12h"

